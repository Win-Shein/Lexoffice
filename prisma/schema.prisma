// Lexoffice-style German billing application
// Prisma ORM 7 (new `prisma-client` generator + driver adapter)
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum TaxType {
  STANDARD_19 // 19%
  REDUCED_7 // 7%
  EXEMPT_0 // 0% (Kleinunternehmer / Export)
}

enum CategoryType {
  ITEM
  EXPENSE
}

enum InvoiceDocumentType {
  INVOICE
  CREDIT_NOTE // Stornorechnung / Gutschrift
}

model User {
  id           String         @id @default(uuid())
  email        String         @unique
  name         String?
  passwordHash String?
  companyName  String?
  address      String?
  city         String?
  postalCode   String?
  country      String         @default("Deutschland")
  phone        String?
  taxNumber    String? // Steuernummer
  vatId        String? // USt-IdNr.
  iban         String?
  bic          String?
  bankName     String?
  isSmallBiz   Boolean        @default(false) // §19 UStG Kleinunternehmer
  invoiceSeq   Int            @default(0) // running number counter
  creditNoteSeq Int           @default(0) // separate sequence for Stornorechnungen
  invoices     Invoice[]
  expenses     Expense[]
  items        Item[]
  categories   Category[]
  auditLogs    AuditLog[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model Customer {
  id        String    @id @default(uuid())
  name      String
  email     String?
  address   String
  city      String?
  postalCode String?
  country   String    @default("Deutschland")
  vatId     String? // USt-IdNr.
  invoices  Invoice[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Invoice {
  id              String        @id @default(uuid())
  invoiceNumber   String        @unique
  documentType    InvoiceDocumentType @default(INVOICE)
  issueDate       DateTime      @default(now())
  dueDate         DateTime
  performanceDate DateTime      @default(now())

  // Revisionssicherheit: once finalized (issued) the document is immutable
  finalizedAt     DateTime?
  sellerSnapshot  String? // JSON snapshot of seller data at issuance
  customerSnapshot String? // JSON snapshot of customer data at issuance
  contentHash     String? // SHA-256 over the immutable document content

  // Stornorechnung / Gutschrift link to the corrected original
  originalInvoiceId String?
  originalInvoice   Invoice?  @relation("InvoiceCorrections", fields: [originalInvoiceId], references: [id])
  corrections       Invoice[] @relation("InvoiceCorrections")

  userId   String
  user     User   @relation(fields: [userId], references: [id])

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  subtotalNet Float
  vatRate     Float   @default(19.0)
  vatAmount   Float
  totalGross  Float

  taxType         TaxType @default(STANDARD_19)
  isSmallBiz      Boolean @default(false) // §19 UStG
  isReverseCharge Boolean @default(false) // §13b UStG

  notes           String?
  status          InvoiceStatus @default(DRAFT)
  paidAt          DateTime?
  sentAt          DateTime?
  items           InvoiceItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  seq       Int      @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  entity    String // e.g. "Invoice"
  entityId  String
  action    String // CREATE | STATUS_CHANGE | ISSUE | DELETE | CREDIT_NOTE
  before    String? // JSON snapshot of relevant state before the change
  after     String? // JSON snapshot of relevant state after the change
  hash      String // SHA-256 over prevHash + this entry
  prevHash  String? // previous entry hash (hash chain)
  createdAt DateTime @default(now())

  @@index([userId, seq])
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Float
  unit        String  @default("Stück")
  unitPrice   Float
  totalNet    Float
  taxType     TaxType @default(STANDARD_19)
}

model Category {
  id        String       @id @default(uuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  name      String
  type      CategoryType
  parentId  String?
  parent    Category?    @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children  Category[]   @relation("CategoryHierarchy")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([userId, type, name])
}

model Item {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  name        String
  category    String   @default("Sonstiges")
  unit        String   @default("Stück")
  unitPrice   Float
  taxType     TaxType  @default(STANDARD_19)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Expense {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  description   String
  vendor        String?
  category      String   @default("Sonstiges")
  documentNumber String? // Belegnummer
  amountNet     Float
  vatRate       Float    @default(19.0)
  vatAmount     Float
  amountGross   Float
  date          DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
